<mjml>
	<mj-head>
		<mj-font
			name="ivymode-variable"
			href="https://use.typekit.net/fsk6air.css"
		/>
		<mj-font
			name="brandon-grotesque"
			href="https://use.typekit.net/fsk6air.css"
		/>
		<mj-style>
			@import url('https://use.typekit.net/fsk6air.css'); body {
			font-family: 'brandon-grotesque', sans-serif; } h1, h2, h3, h4, h5,
			h6 { font-family: 'ivymode-variable', serif; font-weight: normal;} a
			{ color: #ff5e5b; } button { font-family: 'brandon-grotesque',
			sans-serif; font-size: 18px; }
		</mj-style>
	</mj-head>
	<mj-body background-color="#ffffea">
		<mj-section background-color="#ffffea">
			<mj-column>
				<mj-image
					width="200px"
					src="https://denw90a2l8ovn.cloudfront.net/babysad-frown-upside-down.gif"
					alt="Baby Sad Cards"
				/>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffed66" padding="20px">
			<mj-column>
				<mj-text
					font-size="36px"
					color="#0d0d0d"
					align="center"
					font-family="ivymode-variable, serif"
				>
					New Order Received
				</mj-text>
				<mj-text
					font-size="20px"
					color="#0d0d0d"
					align="center"
					padding-top="10px"
					font-family="brandon-grotesque, sans-serif"
					line-height="1.5"
				>
					A new <%- orderType %> order has been placed.
				</mj-text>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffffea" padding="20px">
			<mj-column>
				<mj-text
					font-size="22px"
					color="#0d0d0d"
					font-family="ivymode-variable, serif"
				>
					Order Summary
				</mj-text>
				<mj-table
					cellpadding="10px"
					cellspacing="0"
					border="none"
					width="100%"
					font-family="brandon-grotesque, sans-serif"
				>
					<tr
						style="
							background-color: #ffffea;
							font-weight: bold;
							color: #0d0d0d;
							font-size: 18px;
							border-bottom: 1px solid #d8d8d8;
						"
					>
						<td style="padding: 10px">Order ID</td>
						<td style="padding: 10px"><%- orderId %></td>
					</tr>
					<tr
						style="
							color: #0d0d0d;
							font-size: 18px;
							background-color: #ffffea;
							border-bottom: 1px solid #d8d8d8;
						"
					>
						<td style="padding: 10px">Order Type</td>
						<td style="padding: 10px"><%- orderType %></td>
					</tr>
					<tr
						style="
							background-color: #ffffea;
							color: #0d0d0d;
							font-size: 18px;
							border-bottom: 1px solid #d8d8d8;
						"
					>
						<td style="padding: 10px">Customer Email</td>
						<td style="padding: 10px"><%- customerEmail %></td>
					</tr>
					<tr
						style="
							color: #0d0d0d;
							font-size: 18px;
							background-color: #ffffea;
							border-bottom: 1px solid #d8d8d8;
						"
					>
						<td style="padding: 10px">Shipping Method</td>
						<td style="padding: 10px"><%- shippingMethod %></td>
					</tr>
					<tr
						style="
							background-color: #ffffea;
							color: #0d0d0d;
							font-size: 18px;
							border-bottom: 1px solid #d8d8d8;
						"
					>
						<td style="padding: 10px">Order Date</td>
						<td style="padding: 10px"><%- orderDate %></td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffffea" padding="20px">
			<mj-column>
				<mj-text
					font-size="22px"
					color="#0d0d0d"
					font-family="ivymode-variable, serif"
				>
					Delivery Address
				</mj-text>
				<mj-text
					color="#0d0d0d"
					padding-top="10px"
					font-family="brandon-grotesque, sans-serif"
					font-size="18px"
					line-height="1.5"
				>
					<%- recipientName %><br />
					<%- address1 %><br />
					<% if (address2) { %><%- address2 %><br /><% } %> <%- city
					%><br />
					<%- postcode %>
				</mj-text>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffffea" padding="20px">
			<mj-column>
				<mj-text
					font-size="22px"
					color="#0d0d0d"
					font-family="ivymode-variable, serif"
				>
					Order Details
				</mj-text>
				<mj-text
					color="#0d0d0d"
					padding-top="10px"
					font-family="brandon-grotesque, sans-serif"
					font-size="18px"
					line-height="1.5"
				>
					<%- orderDetails %>
				</mj-text>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffffea" padding="20px">
			<mj-column>
				<mj-button
					href="https://babysad-dashboard.netlify.app/orders/<%- orderId %>"
					background-color="#ffffea"
					color="#0d0d0d"
					font-size="18px"
					font-family="brandon-grotesque, sans-serif"
					border="1px solid #ff5e5b"
					border-radius="50px"
				>
					View Order in Dashboard
				</mj-button>
			</mj-column>
		</mj-section>

		<mj-section background-color="#ffffea" padding="20px">
			<mj-column>
				<mj-text
					font-size="14px"
					color="#999"
					align="center"
					font-family="brandon-grotesque, sans-serif"
				>
					© 2025 Baby Sad Cards. All rights reserved.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
